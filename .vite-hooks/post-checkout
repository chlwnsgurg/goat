#!/usr/bin/env sh
# `git worktree add` runs post-checkout inside the new checkout with an all-zero previous HEAD.
# Set that checkout up like the goat.json Setup Worktree action, so a worktree made by any tool
# (GOAT, Codex, an agent running git) has dependencies when the command returns.
# GOAT_WORKTREE_SETUP=0 skips it; GOAT sets it for thread worktrees, where it runs the same
# setup as a visible launch step. A failed setup never fails the checkout.
[ "$1" = 0000000000000000000000000000000000000000 ] || exit 0
[ "${GOAT_WORKTREE_SETUP:-}" != 0 ] || exit 0
[ -z "${CI:-}" ] || exit 0
root=$(git rev-parse --show-toplevel) || exit 0
[ ! -e "$root/node_modules" ] || exit 0
[ -f "$root/scripts/setup-worktree.ts" ] || exit 0

echo "goat post-checkout: setting up $root (GOAT_WORKTREE_SETUP=0 skips this)" >&2
if ! node "$root/scripts/setup-worktree.ts" >&2; then
  echo "goat post-checkout: setup failed; run 'node scripts/setup-worktree.ts' in $root" >&2
fi
exit 0
