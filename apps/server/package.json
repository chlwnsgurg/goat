{
  "name": "goat",
  "version": "0.1.1",
  "license": "MIT",
  "bin": {
    "goat": "./dist/bin.mjs",
    "t3": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=../../packages --watch-path=package.json src/bin.ts",
    "build:bundle": "vp pack",
    "build:exe": "node scripts/cli.ts build-exe",
    "start": "node dist/bin.mjs",
    "typecheck": "tsc-rs --noEmit",
    "test": "vp test run",
    "record:codex-replay": "bun scripts/record-codex-app-server-replay-fixture.ts",
    "record:claude-replay": "bun scripts/record-claude-agent-sdk-replay-fixture.ts",
    "record:cursor-replay": "node --env-file-if-exists=../../.env --experimental-strip-types scripts/record-cursor-agent-sdk-replay-fixture.ts",
    "record:pi-replay": "node scripts/record-pi-rpc-replay-fixture.ts",
    "record:grok-replay": "node scripts/record-grok-acp-replay-fixture.ts",
    "record:muse-replay": "node scripts/record-muse-msp-replay-fixture.ts",
    "generate": "graphqlgen",
    "generate:expo-schema": "node scripts/fetch-expo-schema.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.276",
    "@cursor/sdk": "1.0.35",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@ff-labs/fff-node": "0.11.0",
    "@goat/provider-acp": "workspace:*",
    "@goat/provider-acp-registry": "workspace:*",
    "@goat/provider-claude-cloud": "workspace:*",
    "@goat/provider-core": "workspace:*",
    "@goat/provider-cursor": "workspace:*",
    "@goat/provider-devin-cloud": "workspace:*",
    "@goat/provider-grok": "workspace:*",
    "@goat/provider-muse": "workspace:*",
    "@goat/provider-opencode": "workspace:*",
    "@goat/provider-pi": "workspace:*",
    "@goat/source-control-azure-devops": "workspace:*",
    "@goat/source-control-bitbucket": "workspace:*",
    "@goat/source-control-core": "workspace:*",
    "@goat/source-control-forgejo": "workspace:*",
    "@goat/source-control-gitcafe": "workspace:*",
    "@goat/source-control-github": "workspace:*",
    "@goat/source-control-gitlab": "workspace:*",
    "@muse-code/sdk": "1.4.6",
    "@napi-rs/keyring": "^1.3.0",
    "@opencode-ai/sdk": "^1.3.15",
    "@slack/socket-mode": "3.1.0",
    "@slack/web-api": "8.2.0",
    "@trycua/cua-driver": "catalog:",
    "effect": "catalog:",
    "jose": "catalog:",
    "node-pty": "^1.2.0-beta.15",
    "playwright-core": "1.60.0",
    "proper-lockfile": "4.1.2",
    "smol-toml": "1.8.0",
    "stream-chain": "^4.2.5",
    "stream-json": "3.6.0",
    "undici": "catalog:",
    "yaml": "catalog:",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@effect/graphql-generator": "catalog:",
    "@effect/vitest": "catalog:",
    "@goat/contracts": "workspace:*",
    "@goat/provider-testing": "workspace:*",
    "@goat/shared": "workspace:*",
    "@goat/source-control-testing": "workspace:*",
    "@goat/ssh": "workspace:*",
    "@goat/tailscale": "workspace:*",
    "@goat/web": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "^4.1.4",
    "@types/yauzl": "^3.4.0",
    "effect-acp": "workspace:*",
    "effect-codex-app-server": "workspace:*",
    "graphql": "16.14.1",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
